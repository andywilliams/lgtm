{
  "name": "lgtm-review",
  "version": "0.1.0",
  "description": "AI-powered PR review CLI — you stay in control",
  "main": "dist/index.js",
  "bin": {
    "lgtm": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test src/*.test.ts",
    "install-global": "npm run build && npm install -g .",
    "uninstall-global": "npm uninstall -g lgtm-review",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "pr",
    "review",
    "ai",
    "claude",
    "code-review",
    "cli"
  ],
  "author": "Andy Williams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andywilliams/lgtm.git"
  },
  "bugs": {
    "url": "https://github.com/andywilliams/lgtm/issues"
  },
  "homepage": "https://github.com/andywilliams/lgtm#readme",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "jsonrepair": "^3.15.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
